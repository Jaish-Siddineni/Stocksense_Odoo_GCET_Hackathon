generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Product {
  id        String   @id @default(uuid())
  sku       String   @unique
  name      String
  category  String
  price     Float
  stock     Int
  createdAt DateTime @default(now())

  receiptItems  ReceiptItem[]
  deliveryItems DeliveryItem[]
}

model Warehouse {
  id         String   @id @default(uuid())
  name       String
  shortCode  String
  address    String

  locations  Location[]
}

model Location {
  id          String   @id @default(uuid())
  name        String
  shortCode   String

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
}

model Receipt {
  id          String   @id @default(uuid())
  supplier    String
  receiptDate DateTime @default(now())

  items ReceiptItem[]
}

model ReceiptItem {
  id         String   @id @default(uuid())

  receiptId  String
  productId  String
  quantity   Int

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Delivery {
  id           String   @id @default(uuid())
  customer     String
  deliveryDate DateTime @default(now())

  items DeliveryItem[]
}

model DeliveryItem {
  id         String   @id @default(uuid())

  deliveryId String
  productId  String
  quantity   Int

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model StockAdjustment {
  id        String   @id @default(uuid())
  productId String
  quantity  Int
  reason    String
  createdAt DateTime @default(now())
}

model StockMovement {
  id           String   @id @default(uuid())
  productId    String
  movementType String
  quantity     Int
  referenceId  String?
  createdAt    DateTime @default(now())
}
model Setting {
  id          String @id @default(uuid())
  companyName String
  adminEmail  String
}